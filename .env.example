# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys (publishable key)
# Also set in Supabase Edge Function secrets: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
VITE_PAYMENTS_CLIENT_TOKEN=pk_live_...

# ── Push Notifications (Web Push / VAPID) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Also set VAPID_PRIVATE_KEY and VAPID_SUBJECT in Supabase Edge Function secrets
VITE_VAPID_PUBLIC_KEY=BN...

# ── Error Monitoring (Sentry) ─────────────────────────────────────────────────
# Found in: sentry.io → Project Settings → Client Keys (DSN)
# Leave empty to disable Sentry
VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs that can access /admin
VITE_ADMIN_USER_IDS=uuid1,uuid2
